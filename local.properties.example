# Copy this file to local.properties and fill in your actual values
# local.properties is excluded from git

# Microsoft Azure Translator key
# Azure Portal > AI services > Translator > Keys and Endpoint
AZURE_TRANSLATION_KEY=YOUR_AZURE_KEY_HERE

# Azure resource region (required for multi-service/regional resources)
# e.g. koreacentral, eastus, japaneast, westeurope
AZURE_TRANSLATION_REGION=koreacentral

# Android SDK location (auto-generated by Android Studio)
sdk.dir=/path/to/your/Android/sdk
